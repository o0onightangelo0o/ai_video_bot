# ───────────── Telegram ─────────────
BOT_TOKEN=YOUR_NEW_TOKEN_HERE
# Comma-separated Telegram user ids allowed to use /stats /ban /unban
ADMIN_ID=123456789

# ───────────── Run mode ─────────────
# polling  -> local dev / VPS
# webhook  -> Koyeb / Render / Fly (recommended in production)
MODE=polling
# Public HTTPS URL of your app (webhook mode only), e.g. https://my-bot-xyz.koyeb.app
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/telegram/webhook
# Random string; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=change_me_to_a_random_string
HOST=0.0.0.0
PORT=8000

# ───────────── Video providers ─────────────
# Priority list. First that is configured is primary, others are fallbacks.
# Examples:  mock   |   replicate,fal,mock   |   replicate,mock
PROVIDER_ORDER=mock
REPLICATE_API_KEY=
REPLICATE_MODEL=wan-video/wan-2.1-1.3b
FAL_API_KEY=
FAL_MODEL=fal-ai/ltx-video
# Generic alias (used by Replicate if REPLICATE_API_KEY is empty)
VIDEO_API_KEY=
JOB_POLL_INTERVAL=5
JOB_TIMEOUT=900

# ───────────── Limits / protection ─────────────
MAX_REQUESTS_PER_HOUR=3
QUEUE_WORKERS=2
MAX_QUEUE_SIZE=50
PROMPT_MIN_LEN=5
PROMPT_MAX_LEN=500
# Comma-separated, case-insensitive
BANNED_WORDS=nsfw,nude,gore

# ───────────── Storage / logs ─────────────
DB_PATH=/app/data/bot.db
LOG_DIR=/app/logs
LOG_LEVEL=INFO
DEFAULT_LANG=en
